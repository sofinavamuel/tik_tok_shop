{
  "kind": "collectionType",
  "collectionName": "video-productions",
  "info": {
    "singularName": "video-production",
    "pluralName": "video-productions",
    "displayName": "VideoProduction",
    "description": "Track video production from briefing to final delivery"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "briefing": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::briefing.briefing",
      "inversedBy": "video_production",
      "required": true
    },
    "final_video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "tools_used": {
      "type": "json"
    },
    "production_time_minutes": {
      "type": "integer"
    },
    "cost_eur": {
      "type": "decimal"
    },
    "status": {
      "type": "enumeration",
      "enum": ["in_progress", "completed", "failed"]
    }
  }
}
