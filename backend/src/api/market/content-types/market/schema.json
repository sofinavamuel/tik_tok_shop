{
  "kind": "collectionType",
  "collectionName": "markets",
  "info": {
    "singularName": "market",
    "pluralName": "markets",
    "displayName": "Market",
    "description": "TikTok Shop market regions"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "currency": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "tiktok_shop_active": {
      "type": "boolean",
      "default": true
    },
    "gmv_total": {
      "type": "decimal"
    },
    "growth_rate": {
      "type": "decimal"
    },
    "saturation_score": {
      "type": "decimal"
    }
  }
}
